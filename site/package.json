{
  "name": "atif-sql-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Documentation site for atif-sql, with the machine-readable surface an agent fetches.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sync": "node scripts/sync-ccu.mjs --source ../docs --target src/content/docs",
    "authored": "node scripts/authored-pages.mjs --source authored --target src/content/docs",
    "content": "pnpm run sync && pnpm run authored",
    "gate:braces": "node gates/brace-gate.mjs src/content/docs",
    "gate:braces:tree": "node gates/brace-gate.mjs --allow-empty ../docs/architecture ../docs/reference ../docs/behavior ../docs/analysis ../docs/diagrams ../docs/insights",
    "prebuild": "pnpm run content && pnpm run gate:braces",
    "build": "astro build",
    "dev": "pnpm run content && astro dev",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "gate": "pnpm run build && pnpm run check && pnpm run test"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.3.8",
    "@astrojs/starlight": "0.41.10",
    "@tabler/icons-astro": "3.46.0",
    "astro": "7.2.9",
    "beautiful-mermaid": "1.1.3",
    "satteri": "0.10.5",
    "starlight-base-path": "0.2.1",
    "starlight-links-validator": "0.25.3",
    "starlight-llms-txt": "0.11.0",
    "starlight-md-txt": "0.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "~5.9.3",
    "vitest": "4.1.11"
  }
}
